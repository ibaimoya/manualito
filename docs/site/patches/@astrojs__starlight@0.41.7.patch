+class SidebarStatePersister extends HTMLElement {
+	private lifecycle = new AbortController();
+
+	connectedCallback() {
+		this.lifecycle = new AbortController();
+		const { signal } = this.lifecycle;
+		this.addEventListener('click', (event) => {
+			if (!(event.target instanceof Element)) return;
+			const details = event.target.closest('summary')?.closest('details');
+			if (!details) return;
+			const restore = details.querySelector<HTMLElement>('sl-sidebar-restore');
+			const index = Number.parseInt(restore?.dataset.index || '');
+			if (Number.isNaN(index)) return;
+			const state = this.getState();
+			state.open[index] = !details.open;
+			this.storeState(state);
+		}, { signal });
+		document.addEventListener('visibilitychange', () => {
+			if (document.visibilityState === 'hidden') this.storeState(this.getState());
+		}, { signal });
+	}
+
+	disconnectedCallback() {
+		this.storeState(this.getState());
+		this.lifecycle.abort();
+	}
+
+	private getState(): SidebarState {
+		const hash = this.dataset.hash || '';
+		let open: SidebarState['open'] = [];
+		try {
+			const storedState = JSON.parse(sessionStorage.getItem(storageKey) || '{}') as SidebarState;
+			if (Array.isArray(storedState.open) && storedState.hash === hash) open = storedState.open;
+		} catch {}
+		return { hash, open, scroll: this.closest('#starlight__sidebar')?.scrollTop || 0 };
+	}
+
+	private storeState(state: SidebarState) {
+		try {
+			sessionStorage.setItem(storageKey, JSON.stringify(state));
+		} catch {}
+	}
+}
 
