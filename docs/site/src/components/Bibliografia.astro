---
import { BIBLIOGRAFIA_ANEXOS, puntuar } from '../datos/bibliografia';

/* Lista numerada de referencias de los anexos, generada desde el bib. */

function dominio(url: string): string {
  return new URL(url).hostname.replace(/^www\./, '');
}
---

<ol class="bibliografia not-content">
  {
    BIBLIOGRAFIA_ANEXOS.map((referencia) => (
      <li id={`ref-${referencia.numero}`}>
        <span class="bibliografia__marca">[{referencia.numero}]</span>
        <div class="bibliografia__cuerpo">
          <p class="bibliografia__cita">
            {referencia.autores && (
              <span class="bibliografia__autores">{puntuar(referencia.autores)} </span>
            )}
            <em class="bibliografia__titulo">{referencia.titulo}</em>
            {/[?!]$/.test(referencia.titulo) ? '' : '.'}
            {referencia.detalle && (
              <span class="bibliografia__detalle"> {puntuar(referencia.detalle)}</span>
            )}
          </p>
          {referencia.url && (
            <a class="bibliografia__fuente" href={referencia.url} rel="noopener">
              {dominio(referencia.url)}
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M7 7h10v10" />
                <path d="M7 17 17 7" />
              </svg>
            </a>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .bibliografia {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    border-block-start: 1px solid var(--sl-color-gray-5);
  }

  .bibliografia li {
    position: relative;
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    padding-block: 1rem;
    border-block-end: 1px solid var(--sl-color-gray-5);
    scroll-margin-block-start: calc(var(--sl-nav-height) + 1.5rem);
    transition: background-color 200ms ease;
  }

  /* La fila entera con fuente es clicable y lo anuncia al pasar por encima. */
  .bibliografia li:has(.bibliografia__fuente):hover {
    background: color-mix(in srgb, var(--m-hover) 55%, transparent);
    border-radius: var(--m-r-md);
    padding-inline: 0.75rem;
    margin-inline: -0.75rem;
  }

  .bibliografia__fuente::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .bibliografia li:last-child {
    border-block-end: 0;
  }

  /* Aterrizar desde una cita destella la entrada y asienta en un tinte suave. */
  .bibliografia li:target {
    background: color-mix(in srgb, var(--sl-color-accent-low) 45%, transparent);
    border-radius: var(--m-r-md);
    padding-inline: 0.75rem;
    margin-inline: -0.75rem;
    animation: destello-referencia 1200ms var(--m-ease-salida);
  }

  @keyframes destello-referencia {
    from {
      background: var(--sl-color-accent-low);
    }
  }

  .bibliografia__marca {
    padding-block-start: 0.125rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    font-variant-numeric: tabular-nums;
  }

  .bibliografia__cuerpo {
    display: grid;
    gap: 0.375rem;
  }

  .bibliografia__cita {
    margin: 0;
    text-align: start;
    line-height: 1.65;
    color: var(--sl-color-gray-2);
  }

  .bibliografia__titulo {
    color: var(--sl-color-gray-1);
    font-weight: 500;
  }

  .bibliografia__detalle {
    color: var(--sl-color-gray-3);
  }

  /* Diana ampliada con margen negativo, el layout visual no cambia. */
  .bibliografia__fuente {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
    padding: 0.625rem 0.75rem;
    margin: -0.625rem -0.75rem;
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }

  .bibliografia__fuente:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .bibliografia__fuente svg {
    inline-size: 0.75rem;
    block-size: 0.75rem;
    transition: translate 160ms var(--m-ease-salida);
  }

  /* La flecha avanza en diagonal, la misma señal de salida que el menú de copiar. */
  @media (hover: hover) and (pointer: fine) {
    .bibliografia__fuente:hover svg {
      translate: 2px -2px;
    }
  }

  /* En papel la URL completa vuelve, que es donde el formato la exige. */
  @media print {
    .bibliografia__fuente::after {
      content: ' (' attr(href) ')';
    }

    .bibliografia__fuente svg {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bibliografia li,
    .bibliografia__fuente svg {
      transition: none;
    }

    .bibliografia li:target {
      animation: none;
    }
  }
</style>
