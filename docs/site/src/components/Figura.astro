---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  alt: string;
  id: string;
  src: ImageMetadata;
}

const { alt, id, src } = Astro.props;
const imagen = await getImage({ src, format: src.format === 'png' ? 'png' : undefined });
---

<figure {id}>
  <a
    class="figura-ampliable"
    href={imagen.src}
    data-pswp-width={src.width}
    data-pswp-height={src.height}
    aria-label={`Ampliar ${alt}`}
  >
    <img src={imagen.src} {...imagen.attributes} {alt} />
  </a>
  <figcaption><slot /></figcaption>
</figure>

<style>
  figure {
    margin-block: 2rem;
  }

  .figura-ampliable {
    display: block;
    cursor: zoom-in;
    border-radius: 0.5rem;
  }

  .figura-ampliable:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 4px;
  }

  figure :global(img) {
    margin-inline: auto;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.5rem;
  }

  figcaption {
    margin-block-start: 0.625rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    text-align: center;
    text-wrap: balance;
  }

  figcaption :global(p) {
    margin: 0;
  }
</style>
