---
/**
 * Fuentes verificadas en el repositorio:
 * - frontend/src/routes/_app.capture.source.tsx
 * - backend/tests/api/test_manuals_service.py
 * - backend/tests/api/test_manuals_pdf.py
 * - backend/tests/rag/test_repository.py
 * - backend/tests/api/test_conversations_service.py
 * - README.md
 */
---

<section
  class="manual-flow not-content"
  data-manual-flow
  aria-label="Fases del procesamiento de un manual"
>
  <ol class="manual-flow__list">
    <li class="manual-flow__step">
      <span class="manual-flow__number" aria-hidden="true">01</span>
      <div>
        <h3>Imagen o PDF</h3>
        <p>El manual se añade con el orden y la visibilidad que has revisado.</p>
      </div>
    </li>
    <li class="manual-flow__step">
      <span class="manual-flow__number" aria-hidden="true">02</span>
      <div>
        <h3>Texto y OCR</h3>
        <p>Se utiliza el texto del PDF cuando está disponible. En los demás casos, se aplica OCR página a página.</p>
      </div>
    </li>
    <li class="manual-flow__step">
      <span class="manual-flow__number" aria-hidden="true">03</span>
      <div>
        <h3>Fragmentos y búsqueda semántica</h3>
        <p>El texto se divide, se indexa y se recuperan los fragmentos relacionados con la consulta.</p>
      </div>
    </li>
    <li class="manual-flow__step">
      <span class="manual-flow__number" aria-hidden="true">04</span>
      <div>
        <h3>Explicación y respuestas</h3>
        <p>El modelo local utiliza esos fragmentos para explicar el juego y responder preguntas.</p>
      </div>
    </li>
  </ol>
  <p class="manual-flow__note">
    Es un esquema del proceso, no un indicador del estado de una subida.
  </p>
</section>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion && 'IntersectionObserver' in window) {
    document.querySelectorAll<HTMLElement>('[data-manual-flow]').forEach((flow) => {
      try {
        flow.dataset.motion = 'ready';

        const observer = new IntersectionObserver(
          (entries) => {
            const visible = entries.some(
              (entry) => entry.isIntersecting && entry.intersectionRatio >= 0.35,
            );

            if (!visible) return;

            flow.dataset.motion = 'play';
            observer.disconnect();
          },
          { threshold: 0.35 },
        );

        observer.observe(flow);
      } catch {
        delete flow.dataset.motion;
      }
    });
  }
</script>

<style>
  .manual-flow {
    --flow-line-start: scaleY(0);
    margin-block: 1.5rem 2.5rem;
  }

  .manual-flow__list {
    display: grid;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .manual-flow__step {
    position: relative;
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    gap: 0.875rem;
    min-width: 0;
    padding: 1rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 1rem;
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--sl-color-accent-low) 32%, transparent),
        transparent 42%
      ),
      var(--sl-color-bg-nav);
    box-shadow: var(--sl-shadow-sm);
  }

  .manual-flow__step::after {
    position: absolute;
    top: 100%;
    left: 1.58rem;
    width: 2px;
    height: 0.875rem;
    background: var(--sl-color-accent);
    content: '';
    transform-origin: top;
  }

  .manual-flow__step:last-child::after {
    content: none;
  }

  .manual-flow__number {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
    border-radius: 0.75rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-text-accent);
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .manual-flow__step h3 {
    margin: 0;
    color: var(--sl-color-white);
    font-size: var(--sl-text-lg);
    line-height: 1.3;
  }

  .manual-flow__step p {
    margin: 0.375rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.55;
  }

  .manual-flow__note {
    margin: 0.875rem 0 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }

  .manual-flow__step:nth-child(1) {
    --flow-step-delay: 0ms;
    --flow-line-delay: 450ms;
  }

  .manual-flow__step:nth-child(2) {
    --flow-step-delay: 700ms;
    --flow-line-delay: 1150ms;
  }

  .manual-flow__step:nth-child(3) {
    --flow-step-delay: 1400ms;
    --flow-line-delay: 1850ms;
  }

  .manual-flow__step:nth-child(4) {
    --flow-step-delay: 2100ms;
  }

  .manual-flow[data-motion='ready'] .manual-flow__step {
    opacity: 0;
    transform: translateY(0.75rem);
  }

  .manual-flow[data-motion='ready'] .manual-flow__step::after {
    opacity: 0;
    transform: var(--flow-line-start);
  }

  .manual-flow[data-motion='play'] .manual-flow__step {
    animation: flow-step-in 700ms cubic-bezier(0.2, 0.8, 0.2, 1) var(--flow-step-delay) both;
  }

  .manual-flow[data-motion='play'] .manual-flow__step::after {
    animation: flow-line-in 450ms ease-out var(--flow-line-delay) both;
  }

  @media (min-width: 64rem) {
    .manual-flow {
      --flow-line-start: scaleX(0);
    }

    .manual-flow__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }

    .manual-flow__step {
      grid-template-columns: 1fr;
      align-content: start;
    }

    .manual-flow__step::after {
      top: 2.25rem;
      left: 100%;
      width: 1rem;
      height: 2px;
      transform-origin: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .manual-flow[data-motion] .manual-flow__step,
    .manual-flow[data-motion] .manual-flow__step::after {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  @keyframes flow-step-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes flow-line-in {
    from {
      opacity: 0;
      transform: var(--flow-line-start);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
