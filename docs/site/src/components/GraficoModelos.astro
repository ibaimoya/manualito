---
import { numero, type Panel } from '../datos/benchmarks';

interface Props { panel: Panel; }
const { panel } = Astro.props;
const maximo = panel.metricas[1].maximo;
const elegido = panel.filas.find((fila) => fila.destacado)!;
const nombrePerfil = panel.titulo.toLowerCase().replaceAll(' ', '-');
---

<div class="grafico-modelos">
  <output aria-live="off">
    <strong data-valor="nombre">{elegido.nombre}</strong>
    <span><b data-valor="fidelidad">{numero(elegido.valores[0], 3)}</b> de fidelidad</span>
    <span><b data-valor="memoria">{numero(elegido.valores[1], 3)}</b> GB</span>
  </output>
  <svg viewBox="0 0 640 380" role="img" aria-labelledby={`${nombrePerfil}-titulo`}>
    <title id={`${nombrePerfil}-titulo`}>Fidelidad y memoria gráfica. {panel.titulo}</title>
    <text class="titulo-eje" x="56" y="18">Fidelidad</text>
    {[0.5, 0.75, 1].map((valor) => (
      <g>
        <line x1="56" x2="612" y1={328 - (valor - 0.5) * 568} y2={328 - (valor - 0.5) * 568} />
        <text x="42" y={333 - (valor - 0.5) * 568} text-anchor="end">{numero(valor, 2)}</text>
      </g>
    ))}
    {[0, 0.25, 0.5, 0.75, 1].map((paso) => (
      <g>
        <line x1={56 + paso * 556} x2={56 + paso * 556} y1="44" y2="328" />
        <text x={56 + paso * 556} y="350" text-anchor="middle">{numero(maximo * paso, 2)}</text>
      </g>
    ))}
    <text class="titulo-eje" x="334" y="377" text-anchor="middle">Memoria gráfica (GB)</text>
    {panel.filas.map((fila, indice) => (
      <g class:list={['punto', { activo: fila.destacado, elegido: fila.destacado }]}
        data-modelo={indice} data-nombre={fila.nombre}
        data-fidelidad={numero(fila.valores[0], 3)} data-memoria={numero(fila.valores[1], 3)}
        transform={`translate(${56 + fila.valores[1] / maximo * 556} ${328 - (fila.valores[0] - 0.5) * 568})`}>
        <title>{fila.nombre}. Fidelidad {fila.valores[0]}. Memoria {fila.valores[1]} GB</title>
        <circle class="area" r="12" />
        <circle class="marca" r="5" />
      </g>
    ))}
  </svg>
  <div class="modelos" aria-label={`Modelos del ${panel.titulo.toLowerCase()}`}>
    {panel.filas.map((fila, indice) => (
      <button type="button" class:list={{ activo: fila.destacado }} data-modelo={indice}
        data-nombre={fila.nombre} data-fidelidad={numero(fila.valores[0], 3)}
        data-memoria={numero(fila.valores[1], 3)}
        aria-label={`${fila.nombre}. Fidelidad ${numero(fila.valores[0], 3)}. Memoria ${numero(fila.valores[1], 3)} GB`}>
        {fila.nombre}
      </button>
    ))}
  </div>
</div>

<script>
  import { alCambiarPagina } from '../scripts/ciclo-pagina';

  alCambiarPagina(() => {
    const controlador = new AbortController();
    for (const grafico of document.querySelectorAll<HTMLElement>('.grafico-modelos')) {
      const modelos = grafico.querySelectorAll<HTMLElement | SVGElement>('[data-modelo]');
      const inspeccionar = (evento: Event) => {
        if (!(evento.target instanceof Element)) return;
        const modelo = evento.target.closest<HTMLElement | SVGElement>('[data-modelo]');
        if (!modelo) return;
        for (const elemento of modelos) {
          elemento.classList.toggle('activo', elemento.dataset.modelo === modelo.dataset.modelo);
        }
        for (const campo of grafico.querySelectorAll<HTMLElement>('[data-valor]')) {
          campo.textContent = modelo.dataset[campo.dataset.valor!]!;
        }
      };
      for (const evento of ['pointerover', 'focusin', 'click']) {
        grafico.addEventListener(evento, inspeccionar, { signal: controlador.signal });
      }
    }
    return () => controlador.abort();
  });
</script>

<style>
  output { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.375rem 1.25rem; margin-bottom: 1.5rem; font-size: 0.8125rem; font-variant-numeric: tabular-nums; }
  output strong { width: 100%; color: var(--sl-color-white); font-size: 1rem; font-weight: 600; }
  output > * { margin: 0; }
  output b { color: var(--sl-color-white); font-weight: 500; }
  svg { display: block; width: 100%; height: auto; overflow: visible; }
  text { fill: var(--sl-color-gray-2); font: 14px var(--sl-font); }
  .titulo-eje { fill: var(--sl-color-white); }
  line { stroke: var(--sl-color-hairline-light); }
  .area { fill: transparent; }
  .marca { fill: var(--sl-color-gray-3); stroke: var(--sl-color-bg); stroke-width: 2; }
  .punto { cursor: crosshair; }
  .elegido .marca, .activo .marca { fill: var(--sl-color-text-accent); }
  .activo .marca { r: 7; stroke: var(--sl-color-white); }
  .modelos { display: flex; flex-wrap: wrap; gap: 0.375rem; margin-top: 1.5rem; }
  button { margin: 0; border: 1px solid transparent; border-radius: 0.375rem; background: transparent; color: var(--sl-color-gray-2); padding: 0.5rem 0.625rem; font: 0.8125rem var(--sl-font); cursor: pointer; }
  button.activo { background: var(--sl-color-bg-sidebar); color: var(--sl-color-text-accent); border-color: var(--sl-color-hairline-light); }
  button:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 2px; }
  @media (max-width: 30rem) { text { font-size: 20px; } }
</style>
