<div class="progreso-lectura" data-progreso-lectura aria-hidden="true"></div>

<script>
  import { motionValue, scroll, springValue, styleEffect, transformValue } from 'motion';
  import { alCambiarPagina } from '../scripts/ciclo-pagina';

  alCambiarPagina(() => {
    const elemento = document.querySelector<HTMLElement>('[data-progreso-lectura]');
    if (!elemento) return;

    const menosMovimiento = matchMedia('(prefers-reduced-motion: reduce)');
    const objetivo = motionValue(0);
    const progreso = menosMovimiento.matches
      ? objetivo
      : springValue(objetivo, {
          stiffness: 1200,
          damping: 41,
          mass: 0.35,
          restDelta: 0.0005,
          restSpeed: 0.01,
        });
    const transform = transformValue(() => `scaleX(${progreso.get()})`);

    const dejarDePintar = styleEffect(elemento, { transform });
    const dejarDeSeguir = scroll((valor: number) => objetivo.set(valor));

    return () => {
      dejarDeSeguir();
      dejarDePintar();
      transform.destroy();
      if (progreso !== objetivo) progreso.destroy();
      objetivo.destroy();
    };
  });
</script>

<style>
  .progreso-lectura {
    position: absolute;
    inset-inline: 0;
    inset-block-end: -1px;
    block-size: 0.1875rem;
    background: var(--sl-color-text-accent);
    pointer-events: none;
    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
  }

  @media print {
    .progreso-lectura {
      display: none;
    }
  }
</style>
