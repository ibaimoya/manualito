---
import { Icon } from '@astrojs/starlight/components';

/*
 * Sustituye @astrojs/starlight/components/ThemeSelect.astro porque el selector
 * nativo no permite mostrar iconos en sus opciones de forma consistente.
 * Se conserva ThemeProvider para aplicar el tema antes de pintar la página.
 */
const accessibleLabel = Astro.locals.t('themeSelect.accessibleLabel');
const darkLabel = Astro.locals.t('themeSelect.dark');
const lightLabel = Astro.locals.t('themeSelect.light');
const autoLabel = Astro.locals.t('themeSelect.auto');
---

<starlight-theme-select data-accessible-label={accessibleLabel}>
  <button
    class="theme-trigger"
    type="button"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-label={`${accessibleLabel}: ${autoLabel}`}
    title={`${accessibleLabel}: ${autoLabel}`}
  >
    <Icon name="laptop" class="label-icon" />
    <Icon name="down-caret" class="theme-trigger__caret" />
  </button>

  <div class="theme-menu" role="menu" aria-label={accessibleLabel} hidden inert>
    <button
      class="theme-option"
      type="button"
      role="menuitemradio"
      aria-checked="false"
      tabindex="-1"
      data-theme-value="dark"
      data-theme-label={darkLabel}
    >
      <Icon name="moon" class="theme-option__icon" />
      <span>{darkLabel}</span>
      <Icon name="approve-check" class="theme-option__check" />
    </button>

    <button
      class="theme-option"
      type="button"
      role="menuitemradio"
      aria-checked="false"
      tabindex="-1"
      data-theme-value="light"
      data-theme-label={lightLabel}
    >
      <Icon name="sun" class="theme-option__icon" />
      <span>{lightLabel}</span>
      <Icon name="approve-check" class="theme-option__check" />
    </button>

    <button
      class="theme-option"
      type="button"
      role="menuitemradio"
      aria-checked="true"
      tabindex="0"
      data-theme-value="auto"
      data-theme-label={autoLabel}
    >
      <Icon name="laptop" class="theme-option__icon" />
      <span>{autoLabel}</span>
      <Icon name="approve-check" class="theme-option__check" />
    </button>
  </div>
</starlight-theme-select>

{/* Se ejecuta en línea para que el icono inicial coincida con la preferencia guardada. */}
<script is:inline>
  StarlightThemeProvider.updatePickers();
</script>

<script>
  type Theme = 'auto' | 'dark' | 'light';

  declare const StarlightThemeProvider: {
    updatePickers: (theme?: Theme) => void;
  };

  const storageKey = 'starlight-theme';
  let themeTransitionTimer: number | undefined;

  const parseTheme = (theme: unknown): Theme =>
    theme === 'auto' || theme === 'dark' || theme === 'light' ? theme : 'auto';

  const loadTheme = (): Theme =>
    parseTheme(typeof localStorage !== 'undefined' && localStorage.getItem(storageKey));

  function storeTheme(theme: Theme): void {
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem(storageKey, theme === 'light' || theme === 'dark' ? theme : '');
    }
  }

  const getPreferredColorScheme = (): Theme =>
    matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

  function updateControls(theme: Theme): void {
    document.querySelectorAll<HTMLElement>('starlight-theme-select').forEach((picker) => {
      const trigger = picker.querySelector<HTMLButtonElement>('.theme-trigger');
      const options = picker.querySelectorAll<HTMLButtonElement>('[role="menuitemradio"]');
      let selectedLabel = '';

      options.forEach((option) => {
        const isSelected = option.dataset.themeValue === theme;
        option.setAttribute('aria-checked', String(isSelected));
        option.tabIndex = isSelected ? 0 : -1;
        if (isSelected) selectedLabel = option.dataset.themeLabel ?? '';
      });

      const label = picker.dataset.accessibleLabel ?? '';
      const currentLabel = selectedLabel ? `${label}: ${selectedLabel}` : label;
      trigger?.setAttribute('aria-label', currentLabel);
      trigger?.setAttribute('title', currentLabel);
    });
  }

  function onThemeChange(theme: Theme): void {
    StarlightThemeProvider.updatePickers(theme);
    document.documentElement.dataset.theme = theme === 'auto' ? getPreferredColorScheme() : theme;
    storeTheme(theme);
    updateControls(theme);
  }

  function transitionTheme(theme: Theme, animate: boolean): void {
    const root = document.documentElement;
    const canAnimate =
      animate &&
      root.dataset.theme !== (theme === 'auto' ? getPreferredColorScheme() : theme) &&
      !matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!canAnimate) return onThemeChange(theme);
    clearTimeout(themeTransitionTimer);
    root.dataset.themeTransition = '';
    void getComputedStyle(root).color;
    onThemeChange(theme);
    themeTransitionTimer = window.setTimeout(() => delete root.dataset.themeTransition, 220);
  }

  class ManualitoThemeSelect extends HTMLElement {
    private trigger: HTMLButtonElement | null = null;
    private menu: HTMLElement | null = null;
    private options: HTMLButtonElement[] = [];
    private cierreTimer: number | undefined;

    connectedCallback(): void {
      if (this.dataset.initialized === 'true') return;
      this.dataset.initialized = 'true';

      this.trigger = this.querySelector<HTMLButtonElement>('.theme-trigger');
      this.menu = this.querySelector<HTMLElement>('.theme-menu');
      this.options = Array.from(
        this.querySelectorAll<HTMLButtonElement>('[role="menuitemradio"]'),
      );

      this.trigger?.addEventListener('click', this.handleTriggerClick);
      this.trigger?.addEventListener('keydown', this.handleTriggerKeyDown);
      this.menu?.addEventListener('keydown', this.handleMenuKeyDown);
      this.options.forEach((option) => option.addEventListener('click', this.handleOptionClick));
      document.addEventListener('pointerdown', this.handleOutsidePointerDown);
      document.addEventListener('focusin', this.handleDocumentFocus);

      onThemeChange(loadTheme());
    }

    disconnectedCallback(): void {
      this.trigger?.removeEventListener('click', this.handleTriggerClick);
      this.trigger?.removeEventListener('keydown', this.handleTriggerKeyDown);
      this.menu?.removeEventListener('keydown', this.handleMenuKeyDown);
      this.options.forEach((option) =>
        option.removeEventListener('click', this.handleOptionClick),
      );
      document.removeEventListener('pointerdown', this.handleOutsidePointerDown);
      document.removeEventListener('focusin', this.handleDocumentFocus);
    }

    private openMenu(focus: 'first' | 'last' | 'selected' | null = null): void {
      if (!this.menu || !this.trigger) return;

      document.querySelectorAll<HTMLElement>('starlight-theme-select').forEach((picker) => {
        if (picker === this) return;
        const menu = picker.querySelector<HTMLElement>('.theme-menu');
        menu?.removeAttribute('data-open');
        menu?.setAttribute('inert', '');
        menu?.setAttribute('hidden', '');
        picker.querySelector<HTMLElement>('.theme-trigger')?.setAttribute('aria-expanded', 'false');
      });

      // Las aperturas por teclado no se animan porque el foco solo llega con flechas o Enter.
      this.menu.toggleAttribute('data-instant', focus !== null);
      clearTimeout(this.cierreTimer);
      this.menu.inert = false;
      this.menu.hidden = false;
      // Reflow para que el navegador tome el estado cerrado como punto de partida.
      void this.menu.offsetWidth;
      this.menu.setAttribute('data-open', '');
      this.trigger.setAttribute('aria-expanded', 'true');

      if (focus === null) return;
      const selectedIndex = this.options.findIndex(
        (option) => option.getAttribute('aria-checked') === 'true',
      );
      const targetIndex =
        focus === 'first'
          ? 0
          : focus === 'last'
            ? this.options.length - 1
            : Math.max(0, selectedIndex);
      this.focusOption(targetIndex);
    }

    private closeMenu(restoreFocus = false): void {
      if (!this.menu || !this.trigger) return;
      const menu = this.menu;
      menu.removeAttribute('data-open');
      menu.inert = true;
      this.trigger.setAttribute('aria-expanded', 'false');
      if (restoreFocus) this.trigger.focus();

      clearTimeout(this.cierreTimer);
      const instantaneo =
        menu.hasAttribute('data-instant') ||
        matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (instantaneo) {
        menu.hidden = true;
        return;
      }
      this.cierreTimer = window.setTimeout(() => {
        menu.hidden = true;
      }, 180);
    }

    private focusOption(index: number): void {
      if (this.options.length === 0) return;
      const normalizedIndex = (index + this.options.length) % this.options.length;
      this.options.forEach((option, optionIndex) => {
        option.tabIndex = optionIndex === normalizedIndex ? 0 : -1;
      });
      this.options[normalizedIndex]?.focus();
    }

    private handleTriggerClick = (event: MouseEvent): void => {
      if (this.menu?.hasAttribute('data-open')) {
        this.closeMenu();
      } else {
        this.openMenu(event.detail === 0 ? 'selected' : null);
      }
    };

    private handleTriggerKeyDown = (event: KeyboardEvent): void => {
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        this.openMenu(event.key === 'ArrowDown' ? 'selected' : 'last');
      } else if (event.key === 'Escape') {
        this.closeMenu();
      }
    };

    private handleMenuKeyDown = (event: KeyboardEvent): void => {
      if (event.key === 'Escape') {
        event.preventDefault();
        this.closeMenu(true);
        return;
      }

      const currentIndex = this.options.indexOf(event.target as HTMLButtonElement);
      if (currentIndex < 0) return;

      if (event.key === 'ArrowDown') {
        event.preventDefault();
        this.focusOption(currentIndex + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        this.focusOption(currentIndex - 1);
      } else if (event.key === 'Home') {
        event.preventDefault();
        this.focusOption(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        this.focusOption(this.options.length - 1);
      } else if (event.key === 'Tab') {
        setTimeout(() => this.closeMenu(), 0);
      }
    };

    private handleOptionClick = (event: MouseEvent): void => {
      const option = event.currentTarget;
      if (!(option instanceof HTMLButtonElement)) return;
      this.closeMenu(true);
      transitionTheme(parseTheme(option.dataset.themeValue), event.detail > 0);
    };

    private handleOutsidePointerDown = (event: PointerEvent): void => {
      if (event.target instanceof Node && !this.contains(event.target)) this.closeMenu();
    };

    private handleDocumentFocus = (event: FocusEvent): void => {
      if (event.target instanceof Node && !this.contains(event.target)) this.closeMenu();
    };
  }

  if (!customElements.get('starlight-theme-select')) {
    customElements.define('starlight-theme-select', ManualitoThemeSelect);
  }

  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (loadTheme() === 'auto') onThemeChange('auto');
  });
</script>

<style>
  :global(html[data-theme-transition]),
  :global(html[data-theme-transition] *),
  :global(html[data-theme-transition] *::before),
  :global(html[data-theme-transition] *::after) {
    transition-property: background-color, border-color, color, fill, stroke;
    transition-duration: 180ms;
    transition-timing-function: cubic-bezier(0.23, 1, 0.32, 1);
  }

  starlight-theme-select {
    --ease-salida: cubic-bezier(0.23, 1, 0.32, 1);
    position: relative;
    display: inline-flex;
  }

  .theme-trigger,
  .theme-option {
    border: 0;
    font: inherit;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .theme-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    inline-size: 3rem;
    block-size: 2.75rem;
    padding: 0;
    border-radius: 0.625rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    transition:
      background-color 160ms ease,
      color 160ms ease,
      scale 160ms var(--ease-salida);
  }

  .theme-trigger:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  .theme-trigger:active {
    scale: 0.96;
  }

  .theme-trigger__caret {
    transition: rotate 180ms var(--ease-salida);
  }

  .theme-trigger[aria-expanded='true'] .theme-trigger__caret {
    rotate: 180deg;
  }

  .theme-trigger:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  :global(.label-icon) {
    inline-size: 1rem;
    block-size: 1rem;
  }

  .theme-trigger__caret {
    inline-size: 0.875rem;
    block-size: 0.875rem;
  }

  .theme-menu {
    position: absolute;
    z-index: 1;
    inset-block-start: calc(100% + 0.5rem);
    inset-inline-end: 0;
    display: grid;
    gap: 0.125rem;
    min-inline-size: 11rem;
    max-block-size: calc(100svh - var(--sl-nav-height) - 0.5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.375rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--m-r-lg);
    background: var(--sl-color-bg-nav);
    box-shadow: var(--sl-shadow-md);
    transform-origin: top right;
    opacity: 0;
    scale: 0.94;
    translate: 0 -4px;
    pointer-events: none;
    transition:
      opacity 180ms var(--ease-salida),
      scale 180ms var(--ease-salida),
      translate 180ms var(--ease-salida);
  }

  .theme-menu[data-open] {
    opacity: 1;
    scale: 1;
    translate: 0 0;
    pointer-events: auto;
  }

  .theme-menu[hidden] {
    display: none;
  }

  .theme-menu[data-instant] {
    transition-duration: 0ms;
  }

  .theme-option {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr) 1rem;
    align-items: center;
    gap: 0.625rem;
    min-block-size: 2.75rem;
    padding: 0.5rem 0.625rem;
    border-radius: var(--m-r-md);
    background: transparent;
    color: var(--sl-color-gray-1);
    font-weight: 600;
    text-align: start;
  }

  .theme-option:hover,
  .theme-option:focus-visible {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  .theme-option:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: -2px;
  }

  .theme-option[aria-checked='true'] {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
  }

  .theme-option__icon {
    inline-size: 1rem;
    block-size: 1rem;
  }

  .theme-option__check {
    inline-size: 0.875rem;
    block-size: 0.875rem;
    opacity: 0;
  }

  .theme-option[aria-checked='true'] .theme-option__check {
    opacity: 1;
  }

  @media (max-width: 49.999rem) {
    .theme-menu {
      inset-block-start: auto;
      inset-block-end: calc(100% + 0.5rem);
      inset-inline-start: 0;
      inset-inline-end: auto;
      transform-origin: bottom left;
      /* El menú sale hacia arriba, así que nace por debajo, junto al botón. */
      translate: 0 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-trigger,
    .theme-trigger__caret,
    .theme-menu {
      transition: none;
    }

    .theme-trigger:active {
      scale: 1;
    }
  }
</style>
