<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';
  import { alCambiarPagina } from '../scripts/ciclo-pagina';

  alCambiarPagina(() => {
    const visor = new PhotoSwipeLightbox({
      gallery: '.figura-ampliable',
      pswpModule: () => import('photoswipe'),
      closeTitle: 'Cerrar imagen',
      zoomTitle: 'Ampliar o reducir',
      errorMsg: 'No se ha podido cargar la imagen.',
      padding: { top: 60, bottom: 24, left: 24, right: 24 },
      secondaryZoomLevel: 1,
      bgOpacity: 0.96,
      mainClass: 'visor-figuras',
    });

    visor.on('afterInit', () => {
      visor.pswp?.element?.setAttribute('aria-label', 'Imagen ampliada');
    });
    visor.init();
    return () => visor.destroy();
  });
</script>

<style is:global>
  .visor-figuras {
    --pswp-bg: var(--sl-color-bg);
    --pswp-icon-color: var(--sl-color-white);
    --pswp-icon-color-secondary: var(--sl-color-bg);
  }

  .visor-figuras .pswp__button:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: -4px;
  }

  .visor-figuras .pswp__img[src$='.svg'] {
    background: #fff8f0;
  }
</style>
