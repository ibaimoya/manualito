---
import { DESTINO_PROVISIONAL } from '../portada-documentacion';
import BandaInstitucional from './BandaInstitucional.astro';

interface Props {
  variante?: 'simple' | 'escalones' | 'fondo';
}

const { variante = 'simple' } = Astro.props;

const rutas = [
  {
    titulo: 'Quiero usar la aplicación',
    detalle: 'El manual de usuario cubre la instalación y el uso habitual.',
  },
  {
    titulo: 'Quiero entender cómo funciona',
    detalle: 'El apartado de diseño detalla la arquitectura de la aplicación.',
  },
  {
    titulo: 'Quiero conocer la metodología de trabajo',
    detalle: 'El plan de proyecto describe cuál ha sido el flujo de trabajo del proyecto.',
  },
];
---

<div class="cj" data-cj data-variante={variante}>
  <div class="cj-velo" data-cj-velo aria-hidden="true"></div>

  <section class="cj-panel" data-cj-panel aria-labelledby="cj-titulo">
    <button
      class="cj-tirador"
      type="button"
      data-cj-tirador
      aria-expanded="false"
      aria-controls="cj-cuerpo"
    >
      <span class="cj-tirador__barra" aria-hidden="true"></span>
      <span class="pd-sr">Abrir por dónde empezar</span>
    </button>

    <div class="cj-cuerpo" id="cj-cuerpo" data-cj-cuerpo>
      <div class="cj-marco">
        <header class="cj-cabecera" data-cj-agarre>
          <div>
            <h2 class="cj-titulo" id="cj-titulo">Por dónde empezar</h2>
            <p class="cj-nota">Quiero saber...</p>
          </div>
          <div class="cj-controles" data-pr-controles>
            <button class="pr-flecha" type="button" data-pr-anterior aria-label="Tarjeta anterior"
              ><svg viewBox="0 0 20 20" aria-hidden="true"
                ><path
                  d="M11.5 5 6.5 10l5 5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              ></button
            >
            <button class="pr-flecha" type="button" data-pr-siguiente aria-label="Tarjeta siguiente"
              ><svg viewBox="0 0 20 20" aria-hidden="true"
                ><path
                  d="m8.5 5 5 5-5 5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              ></button
            >
            <button
              class="pr-flecha"
              type="button"
              data-pr-sentido
              aria-label="Cambiar el sentido de la cinta"
              aria-pressed="false"
              ><svg viewBox="0 0 20 20" aria-hidden="true"
                ><path
                  d="M4 7.5h10M11.5 5 14 7.5 11.5 10M16 12.5H6M8.5 15 6 12.5 8.5 10"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              ></button
            >
          </div>
        </header>

        <div class="pr-arranque__visor">
          <div class="pr-arranque__rutas">
            {
              rutas.map((r) => (
                <a class="pr-ruta" href={DESTINO_PROVISIONAL}>
                  <span class="pr-ruta__titulo">{r.titulo}</span>
                  <span class="pr-ruta__detalle">{r.detalle}</span>
                </a>
              ))
            }
          </div>
        </div>

        <BandaInstitucional />

        <a class="cj-siguiente" href={DESTINO_PROVISIONAL}>
          <span class="cj-siguiente__rotulo">Siguiente</span>
          <span class="cj-siguiente__destino">
            Introducción
            <svg viewBox="0 0 20 20" aria-hidden="true"
              ><path
                d="m8.5 5 5 5-5 5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"></path></svg
            >
          </span>
        </a>
      </div>
    </div>
  </section>
</div>

<style>
  .cj {
    --cj-curva: cubic-bezier(0.32, 0.72, 0, 1);
    --cj-dur: 500ms;
    --cj-tirador: 2.25rem;
    --cj-borde: rgba(247, 236, 215, 0.11);
    --cj-borde-vivo: rgba(247, 236, 215, 0.2);
    --cj-alto: rgba(247, 236, 215, 0.055);
  }

  :root[data-theme='light'] .cj {
    --cj-borde: rgba(31, 22, 17, 0.12);
    --cj-borde-vivo: rgba(31, 22, 17, 0.22);
    --cj-alto: rgba(255, 255, 255, 0.85);
  }

  .cj-velo {
    position: fixed;
    inset: 0;
    z-index: 40;
    opacity: 0;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(6px);
    pointer-events: none;
    transition: opacity var(--cj-dur) var(--cj-curva);
  }

  .cj[data-abierto] .cj-velo {
    opacity: 1;
    pointer-events: auto;
  }

  .cj-panel {
    --cj-bote: 0px;
    --cj-fondo-bote: 1.5rem;
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 41;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    block-size: auto;
    max-block-size: min(78svh, 50rem);
    padding-inline: clamp(1rem, 4vw, 2.5rem);
    padding-block-end: 1.5rem;
    translate: 0 calc(100% - var(--cj-tirador));
    transition: translate var(--cj-dur) var(--cj-curva);
  }

  .cj-panel::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block: calc(0px - var(--cj-fondo-bote)) 0;
    z-index: -1;
    border-start-start-radius: 1.25rem;
    border-start-end-radius: 1.25rem;
    border-block-start: 1px solid var(--cj-borde-vivo);
    background: var(--sl-color-bg-nav);
    box-shadow: 0 -24px 60px -24px rgba(0, 0, 0, 0.55);
    transform: translateY(calc(var(--cj-fondo-bote) - var(--cj-bote)));
    pointer-events: none;
    transition: transform var(--cj-dur) var(--cj-curva);
  }

  .cj[data-abierto] .cj-panel {
    translate: 0 0;
  }

  .cj[data-arrastrando] .cj-panel,
  .cj[data-arrastrando] .cj-panel::before,
  .cj[data-arrastrando] .cj-cabecera,
  .cj[data-arrastrando] .cj-tirador,
  .cj[data-arrastrando] .cj-velo {
    transition: none;
  }

  .cj-tirador {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    inline-size: 100%;
    block-size: var(--cj-tirador);
    padding: 0;
    border: 0;
    background: transparent;
    cursor: grab;
    touch-action: none;
    transition: translate var(--cj-dur) var(--cj-curva);
  }

  .cj[data-arrastrando] .cj-tirador {
    cursor: grabbing;
  }

  .cj-tirador__barra {
    inline-size: 2.5rem;
    block-size: 4px;
    border-radius: 999px;
    background: var(--sl-color-gray-3);
    transition:
      background-color 200ms ease,
      scale 200ms var(--cj-curva);
  }

  @media (hover: hover) and (pointer: fine) {
    .cj-tirador:hover .cj-tirador__barra {
      background: var(--sl-color-gray-2);
      scale: 1.15 1;
    }
  }

  .cj-tirador:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: -4px;
    border-radius: 0.5rem;
  }

  .cj-cuerpo {
    flex: 1;
    min-block-size: 0;
    overflow-y: auto;
    overflow-x: clip;
    overscroll-behavior: contain;
    opacity: 0;
    transition: opacity 240ms ease;
  }

  .cj[data-abierto] .cj-cuerpo {
    opacity: 1;
  }

  .cj-marco {
    max-inline-size: min(var(--sl-content-width), 100%);
    margin-inline: auto;
  }

  .cj-cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-block-end: 1.25rem;
    cursor: grab;
    touch-action: none;
    transition: translate var(--cj-dur) var(--cj-curva);
  }

  .cj-cabecera :is(h2, p, button) {
    cursor: auto;
  }

  .cj-cabecera button {
    cursor: pointer;
  }

  .cj-titulo {
    margin: 0;
    font-size: var(--sl-text-xl);
    line-height: 1.2;
  }

  .cj-nota {
    margin: 0.35rem 0 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }

  .cj-controles {
    display: flex;
    gap: 0.375rem;
  }

  .pr-flecha {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 0.625rem;
    background: transparent;
    color: var(--sl-color-gray-3);
    cursor: pointer;
    transition:
      color 200ms ease,
      border-color 200ms ease;
  }

  .pr-flecha::after {
    content: '';
    position: absolute;
    inset: -0.25rem;
  }

  .pr-flecha svg {
    inline-size: 1.125rem;
    block-size: 1.125rem;
    transition: transform 200ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .pr-flecha:hover {
      border-color: color-mix(in srgb, var(--sl-color-gray-3) 45%, transparent);
      color: var(--sl-color-white);
    }
  }

  .pr-flecha:active {
    transform: scale(0.92);
  }

  .pr-flecha:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }

  .pr-flecha[aria-pressed='true'] svg {
    transform: scaleX(-1);
  }

  .pr-flecha[data-pr-anterior]:active svg {
    transform: translateX(-2px);
  }

  .pr-flecha[data-pr-siguiente]:active svg {
    transform: translateX(2px);
  }

  .pr-arranque__visor {
    overflow: hidden;
    padding: 0.75rem 0.25rem;
    margin: -0.75rem -0.25rem;
    mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
  }

  .pr-arranque__rutas {
    display: flex;
    gap: 1.25rem;
    inline-size: max-content;
    will-change: transform;
  }

  .pr-ruta {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    flex: 0 0 19rem;
    min-block-size: 9.5rem;
    padding: 1.25rem;
    border: 1px solid var(--cj-borde);
    border-radius: 0.875rem;
    background: var(--sl-color-bg-nav);
    box-shadow: inset 0 1px 0 var(--cj-alto);
    color: inherit;
    text-decoration: none;
    /* Propiedades independientes: la marquesina mueve la pista con transform y
       así el hover de la tarjeta no se lo pisa. */
    transition:
      scale 200ms var(--cj-curva),
      translate 200ms var(--cj-curva),
      border-color 200ms ease,
      background-color 200ms ease,
      box-shadow 200ms ease;
  }

  :root[data-theme='light'] .pr-ruta {
    background: var(--m-surface);
    box-shadow:
      inset 0 1px 0 var(--cj-alto),
      0 1px 2px rgba(53, 28, 12, 0.05);
  }

  .pr-ruta__titulo {
    color: var(--sl-color-white);
    font-family: var(--m-font-display);
    font-size: var(--sl-text-base);
    font-weight: 700;
    line-height: 1.3;
    transition: color 200ms ease;
  }

  .pr-ruta__detalle {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .pr-ruta--realce {
    scale: 1.025;
    translate: 0 -2px;
    border-color: color-mix(in srgb, var(--sl-color-accent) 60%, transparent);
    background: color-mix(in srgb, var(--sl-color-accent) 5%, var(--sl-color-bg-nav));
    box-shadow: inset 0 1px 0 var(--cj-alto);
  }

  .pr-ruta--realce .pr-ruta__titulo {
    color: var(--sl-color-text-accent);
  }

  :root[data-theme='light'] .pr-ruta--realce {
    background: color-mix(in srgb, var(--m-primary-50) 55%, var(--m-surface));
    box-shadow:
      inset 0 1px 0 var(--cj-alto),
      0 4px 12px -6px rgba(53, 28, 12, 0.18);
  }

  @media (hover: hover) and (pointer: fine) {
    .pr-ruta:hover {
      scale: 1.025;
      translate: 0 -2px;
      border-color: color-mix(in srgb, var(--sl-color-accent) 60%, transparent);
      background: color-mix(in srgb, var(--sl-color-accent) 5%, var(--sl-color-bg-nav));
    }

    .pr-ruta:hover .pr-ruta__titulo {
      color: var(--sl-color-text-accent);
    }

    :root[data-theme='light'] .pr-ruta:hover {
      background: color-mix(in srgb, var(--m-primary-50) 55%, var(--m-surface));
      box-shadow:
        inset 0 1px 0 var(--cj-alto),
        0 4px 12px -6px rgba(53, 28, 12, 0.18);
    }
  }

  .pr-ruta:active {
    scale: 0.995;
  }

  .pr-ruta:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 3px;
  }

  .cj-siguiente {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    align-items: flex-end;
    margin-block-start: 2.75rem;
    padding: 0.875rem 1.125rem;
    border: 1px solid var(--cj-borde);
    border-radius: var(--m-r-lg);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 200ms ease,
      background-color 200ms ease;
  }

  .cj-siguiente__rotulo {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .cj-siguiente__destino {
    display: inline-flex;
    gap: 0.375rem;
    align-items: center;
    color: var(--sl-color-white);
    font-family: var(--m-font-display);
    font-size: var(--sl-text-lg);
    font-weight: 700;
  }

  .cj-siguiente__destino svg {
    inline-size: 1.125rem;
    block-size: 1.125rem;
    transition: translate 200ms var(--cj-curva);
  }

  @media (hover: hover) and (pointer: fine) {
    .cj-siguiente:hover {
      border-color: color-mix(in srgb, var(--sl-color-accent) 60%, transparent);
      background: color-mix(in srgb, var(--sl-color-accent) 5%, transparent);
    }

    .cj-siguiente:hover .cj-siguiente__destino svg {
      translate: 3px 0;
    }
  }

  .cj-siguiente:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 3px;
  }

  @media (max-width: 50rem) {
    .cj-panel {
      max-block-size: min(88svh, 50rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pr-arranque__rutas {
      inline-size: auto;
      flex-wrap: wrap;
    }

    .pr-ruta:hover,
    .pr-ruta--realce {
      scale: 1;
      translate: none;
    }

    .cj-nota,
    .cj-controles {
      display: none;
    }

    .pr-flecha,
    .pr-flecha svg,
    .cj-velo,
    .cj-panel,
    .cj-panel::before,
    .cj-cabecera,
    .cj-cuerpo,
    .cj-tirador,
    .cj-tirador__barra,
    .cj-siguiente,
    .cj-siguiente__destino svg {
      transition: none;
    }
  }
</style>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-cj]');
  const panel = document.querySelector<HTMLElement>('[data-cj-panel]');
  const velo = document.querySelector<HTMLElement>('[data-cj-velo]');
  const tirador = document.querySelector<HTMLButtonElement>('[data-cj-tirador]');
  const cuerpo = document.querySelector<HTMLElement>('[data-cj-cuerpo]');

  if (raiz && panel && velo && tirador && cuerpo) {
    const variante = raiz.dataset.variante ?? 'simple';
    const menosMovimiento = matchMedia('(prefers-reduced-motion: reduce)');
    const lienzo = document.querySelector<HTMLElement>('.pd-lienzo');

    // El fondo se escala, y un ancestro transformado convertiría el position:fixed
    // del panel en relativo. Fuera del lienzo el cajón conserva su anclaje.
    document.body.appendChild(raiz);

    const VELOCIDAD_DESCARTE = 0.11;
    const RESISTENCIA = 20;
    const RUEDA = 2.4;
    const TAU_RUEDA = 100;
    const REPOSO_RUEDA = 0.5;
    const ESPERA_RUEDA = 100;

    let abierto = false;
    let y = 0;
    let gesto: 'ninguno' | 'puntero' | 'rueda' = 'ninguno';
    let objetivoRueda = 0;
    let cuadroRueda: number | null = null;
    let tiempoRueda = 0;
    let entradaPendienteRueda = false;
    let finRueda: number | null = null;
    let agarreActivo: HTMLElement | null = null;

    // Se mide una vez por gesto: remedirla en cada frame introduce saltos de
    // algún píxel cuando el contenido reacomoda.
    let rCache = 0;
    const recorrido = () => {
      if (gesto === 'ninguno' || !rCache) rCache = panel.offsetHeight - tirador.offsetHeight;
      return rCache;
    };
    const paradas = () => (variante === 'escalones' ? [0, 0.55, 1] : [0, 1]);
    const escalaFondo = variante === 'fondo' ? 44 : 26;

    const goma = (exceso: number) => RESISTENCIA * (1 - 1 / (exceso / RESISTENCIA + 1));

    const moverFondo = (p: number, conTransicion: boolean) => {
      if (!lienzo) return;
      lienzo.style.transition =
        conTransicion && !menosMovimiento.matches
          ? 'scale var(--cj-dur, 500ms) cubic-bezier(0.32, 0.72, 0, 1), translate var(--cj-dur, 500ms) cubic-bezier(0.32, 0.72, 0, 1)'
          : 'none';
      // Misma proporción que Vaul: el ancho se reduce en unos píxeles fijos.
      const escala = 1 - (escalaFondo / window.innerWidth) * p;
      lienzo.style.transformOrigin = 'top center';
      lienzo.style.scale = String(escala);
      lienzo.style.translate = `0 ${14 * p}px`;
    };

    const opacidadCuerpo = (p: number) => Math.min(1, Math.max(0, (p - 0.12) / 0.38));

    const pintarBote = (px: number) => {
      const bote = menosMovimiento.matches ? 0 : Math.max(0, px);
      panel.style.setProperty('--cj-bote', `${bote}px`);
      tirador.style.translate = bote ? `0 ${-bote}px` : '';
      if (agarreActivo && agarreActivo !== tirador) {
        agarreActivo.style.translate = bote ? `0 ${-bote}px` : '';
      }
    };

    const soltarBote = () => {
      panel.style.removeProperty('--cj-bote');
      tirador.style.translate = '';
      if (agarreActivo && agarreActivo !== tirador) agarreActivo.style.translate = '';
      agarreActivo = null;
    };

    const pintar = (px: number) => {
      const r = recorrido();
      const p = 1 - Math.max(0, Math.min(r, px)) / r;
      panel.style.translate = `0 ${Math.max(0, px)}px`;
      velo.style.opacity = String(p);
      cuerpo.style.opacity = String(opacidadCuerpo(p));
      pintarBote(-px);
      moverFondo(p, false);
    };

    const detenerSuavizadoRueda = () => {
      if (cuadroRueda !== null) window.cancelAnimationFrame(cuadroRueda);
      cuadroRueda = null;
      tiempoRueda = 0;
      entradaPendienteRueda = false;
    };

    const aplicar = (p: number) => {
      detenerSuavizadoRueda();
      if (finRueda !== null) window.clearTimeout(finRueda);
      finRueda = null;
      abierto = p > 0.5;
      gesto = 'ninguno';
      raiz.removeAttribute('data-arrastrando');
      soltarBote();
      raiz.toggleAttribute('data-abierto', abierto);
      tirador.setAttribute('aria-expanded', String(abierto));
      velo.style.pointerEvents = abierto ? 'auto' : 'none';
      moverFondo(p, true);
      if (p === 0 || p === 1) {
        // Sin estilos en línea el CSS recupera el mando de la transición.
        panel.style.translate = '';
        velo.style.opacity = '';
        cuerpo.style.opacity = '';
      } else {
        panel.style.translate = `0 ${(1 - p) * recorrido()}px`;
        velo.style.opacity = String(p);
        cuerpo.style.opacity = String(opacidadCuerpo(p));
      }
    };

    const soltarEn = (p: number, velocidad: number, haciaArriba: boolean) => {
      if (velocidad > VELOCIDAD_DESCARTE) return haciaArriba ? 1 : 0;
      return paradas().reduce((a, b) => (Math.abs(b - p) < Math.abs(a - p) ? b : a));
    };

    const cerrar = () => aplicar(0);

    let punteroId: number | null = null;
    let arrastrando = false;
    let inicioY = 0;
    let inicioPx = 0;
    let inicioTiempo = 0;

    const empezar = (ev: PointerEvent, origen: HTMLElement) => {
      if (punteroId !== null || gesto === 'rueda') return;
      if (origen !== tirador && (ev.target as HTMLElement).closest('button, a')) return;
      punteroId = ev.pointerId;
      inicioY = ev.clientY;
      inicioPx = abierto ? 0 : recorrido();
      inicioTiempo = performance.now();
      arrastrando = false;
      agarreActivo = origen;
      origen.setPointerCapture(ev.pointerId);
    };

    const mover = (ev: PointerEvent) => {
      if (ev.pointerId !== punteroId) return;
      const dy = ev.clientY - inicioY;
      if (!arrastrando && Math.abs(dy) < 4) return; // histéresis: evita falsos arrastres
      if (!arrastrando) {
        arrastrando = true;
        gesto = 'puntero';
        raiz.setAttribute('data-arrastrando', '');
      }
      const r = recorrido();
      y = inicioPx + dy;
      if (y < 0) y = -goma(-y);
      else if (y > r) y = r + goma(y - r);
      pintar(y);
    };

    const soltar = (ev: PointerEvent) => {
      if (ev.pointerId !== punteroId) return;
      punteroId = null;
      if (!arrastrando) {
        agarreActivo = null;
        return;
      }
      arrastrando = false;
      const r = recorrido();
      const dy = ev.clientY - inicioY;
      const velocidad = Math.abs(dy) / Math.max(performance.now() - inicioTiempo, 1);
      const p = 1 - Math.max(0, Math.min(r, y)) / r;
      const destino = soltarEn(p, velocidad, dy < 0);
      requestAnimationFrame(() => aplicar(destino));
    };

    for (const agarre of [tirador, ...document.querySelectorAll<HTMLElement>('[data-cj-agarre]')]) {
      agarre.addEventListener('pointerdown', (ev) => empezar(ev, agarre));
      agarre.addEventListener('pointermove', mover);
      agarre.addEventListener('pointerup', soltar);
      agarre.addEventListener('pointercancel', soltar);
      agarre.addEventListener('lostpointercapture', soltar);
    }

    tirador.addEventListener('click', () => {
      if (gesto === 'ninguno') aplicar(abierto ? 0 : 1);
    });

    const cerrarGestoRueda = () => {
      const r = recorrido();
      const p = 1 - Math.max(0, Math.min(r, objetivoRueda)) / r;
      aplicar(soltarEn(p, 0, false));
    };

    const pasoRueda = (ahora: number) => {
      cuadroRueda = null;
      if (gesto !== 'rueda') return;

      const dt = ahora - tiempoRueda;
      tiempoRueda = ahora;
      const avance = 1 - Math.exp(-dt / TAU_RUEDA);
      y += (objetivoRueda - y) * avance;

      if (Math.abs(objetivoRueda - y) < REPOSO_RUEDA) {
        y = objetivoRueda;
        pintar(y);
        if (!entradaPendienteRueda) {
          tiempoRueda = 0;
          return;
        }
      } else {
        pintar(y);
      }

      entradaPendienteRueda = false;
      cuadroRueda = window.requestAnimationFrame(pasoRueda);
    };

    const suavizarHaciaObjetivo = () => {
      entradaPendienteRueda = true;
      if (menosMovimiento.matches) {
        y = objetivoRueda;
        pintar(y);
        entradaPendienteRueda = false;
        return;
      }
      if (cuadroRueda === null) {
        tiempoRueda = performance.now();
        cuadroRueda = window.requestAnimationFrame(pasoRueda);
      }
    };

    window.addEventListener(
      'wheel',
      (ev) => {
        if (arrastrando) return;
        const r = recorrido();
        if (gesto !== 'rueda') {
          const alFinal =
            window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4;
          const puedeAbrir = !abierto && ev.deltaY > 0 && alFinal;
          const puedeCerrar = abierto && ev.deltaY < 0 && cuerpo.scrollTop <= 0;
          if (!puedeAbrir && !puedeCerrar) return;
          gesto = 'rueda';
          y = abierto ? 0 : r;
          objetivoRueda = y;
          raiz.setAttribute('data-arrastrando', '');
        }
        const nuevo = objetivoRueda - ev.deltaY * RUEDA;
        if (nuevo >= r) {
          // Cerrado del todo: se suelta la rueda para que la página vuelva a scrollear.
          objetivoRueda = r;
          cerrarGestoRueda();
          return;
        }
        ev.preventDefault();
        objetivoRueda = nuevo < 0 ? -goma(-nuevo) : nuevo;
        suavizarHaciaObjetivo();
        if (finRueda) window.clearTimeout(finRueda);
        finRueda = window.setTimeout(cerrarGestoRueda, ESPERA_RUEDA);
      },
      { passive: false },
    );

    velo.addEventListener('click', cerrar);

    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape' && abierto) {
        cerrar();
        tirador.focus();
      }
    });

    window.addEventListener('resize', () => {
      if (gesto === 'ninguno') aplicar(abierto ? 1 : 0);
    });

    menosMovimiento.addEventListener('change', () => {
      if (menosMovimiento.matches) soltarBote();
    });

    if (!menosMovimiento.matches) {
      const visor = document.querySelector<HTMLElement>('.pr-arranque__visor');
      const pistaRutas = document.querySelector<HTMLElement>('.pr-arranque__rutas');
      if (visor && pistaRutas) {
        const GAP = 20;
        const originales = Array.from(pistaRutas.children) as HTMLElement[];
        const unidad = originales.length;
        let tercio = (pistaRutas.scrollWidth + GAP) / 1;

        // Copias suficientes para cubrir el visor más el margen que consume un
        // centrado (±1 unidad). Con menos, la cinta deja huecos en pantallas anchas.
        const clonar = () => {
          while (
            pistaRutas.children.length < unidad * 12 &&
            pistaRutas.scrollWidth < visor.clientWidth + 3 * tercio
          ) {
            for (const original of originales) {
              const copia = original.cloneNode(true) as HTMLElement;
              copia.setAttribute('aria-hidden', 'true');
              copia.setAttribute('tabindex', '-1');
              pistaRutas.appendChild(copia);
            }
          }
        };
        clonar();

        let offset = 0;
        let vel = tercio / 30000;
        let quieto = true;
        let tween: { de: number; a: number; t0: number; dur: number } | null = null;
        let ultimo = performance.now();
        let finCentrado = 0;
        let sentido = 1;
        let ultimoClickFlecha = 0;
        let sobreVisor = false;
        let sobreControles = false;
        let temporizador: number | null = null;
        window.setTimeout(() => {
          if (!ultimoClickFlecha && !sobreVisor && !sobreControles) {
            quieto = false;
            ultimo = performance.now();
          }
        }, 1500);

        const pintarCinta = () => {
          pistaRutas.style.transform = `translateX(${-offset}px)`;
        };
        const centrar = (carta: HTMLElement) => {
          quieto = true;
          let destino = carta.offsetLeft - (visor.clientWidth - carta.offsetWidth) / 2;
          // Círculo infinito: se elige la copia equivalente más cercana, así el
          // recorrido es siempre corto y nunca se llega al final de la tira.
          while (destino - offset > tercio / 2) destino -= tercio;
          while (offset - destino > tercio / 2) destino += tercio;
          if (destino < 0) {
            destino += tercio;
            offset += tercio;
            pintarCinta();
          }
          tween = { de: offset, a: destino, t0: performance.now(), dur: 420 };
        };
        const paso = (t: number) => {
          const dt = Math.min(t - ultimo, 64);
          ultimo = t;
          if (tween) {
            const p = Math.min(1, (t - tween.t0) / tween.dur);
            const e = 1 - Math.pow(1 - p, 3);
            offset = tween.de + (tween.a - tween.de) * e;
            if (p >= 1) {
              tween = null;
              finCentrado = t;
            }
            pintarCinta();
          } else if (!quieto) {
            offset += vel * dt * sentido;
            pintarCinta();
          }
          // Con la cinta parada el offset vuelve al primer periodo: los píxeles
          // son idénticos, así que el salto no se ve y nunca se agota la tira.
          if (!tween) offset = ((offset % tercio) + tercio) % tercio;
          requestAnimationFrame(paso);
        };
        pintarCinta();
        requestAnimationFrame(paso);
        window.addEventListener('resize', () => {
          clonar();
          vel = tercio / 30000;
        });

        const cartas = () => Array.from(pistaRutas.querySelectorAll<HTMLElement>('.pr-ruta'));
        const desmarcar = () => {
          for (const c of cartas()) c.classList.remove('pr-ruta--realce');
        };

        // La intención se lee del mousemove: se centra cuando el puntero VISITA
        // una tarjeta distinta moviéndose de verdad. Si es la pista la que se
        // desliza bajo un cursor quieto no hay mousemove, y mientras viaja el
        // tween solo se actualiza la referencia.
        let cartaActual: HTMLElement | null = null;
        visor.addEventListener('mouseenter', () => {
          sobreVisor = true;
          quieto = true;
        });
        visor.addEventListener('mousemove', (ev) => {
          const carta = (ev.target as HTMLElement | null)?.closest<HTMLElement>('.pr-ruta') ?? null;
          if (!carta) {
            cartaActual = null;
            return;
          }
          if (tween || performance.now() - finCentrado < 300) {
            cartaActual = carta;
            return;
          }
          if (carta === cartaActual) return;
          cartaActual = carta;
          ultimoClickFlecha = 0;
          desmarcar();
          centrar(carta);
        });
        pistaRutas.addEventListener('focusin', (ev) => {
          const carta = (ev.target as HTMLElement).closest<HTMLElement>('.pr-ruta');
          if (carta) centrar(carta);
        });

        // Reanuda solo si se cumplen las tres condiciones: +5 s desde el último
        // clic, puntero fuera de las tarjetas y fuera de las flechas.
        const intentaReanudar = () => {
          if (temporizador) {
            window.clearTimeout(temporizador);
            temporizador = null;
          }
          const resta = ultimoClickFlecha ? 5000 - (performance.now() - ultimoClickFlecha) : 0;
          if (resta > 0) {
            temporizador = window.setTimeout(intentaReanudar, resta + 50);
            return;
          }
          if (sobreVisor || sobreControles) return;
          desmarcar();
          ultimoClickFlecha = 0;
          quieto = false;
          tween = null;
          ultimo = performance.now();
        };
        const pasar = (delta: number) => {
          ultimoClickFlecha = performance.now();
          quieto = true;
          const lista = cartas();
          const vc = visor.getBoundingClientRect();
          const centro = vc.left + vc.width / 2;
          let idx = 0;
          let dist = Infinity;
          lista.forEach((c, i) => {
            const r = c.getBoundingClientRect();
            const d = Math.abs(r.left + r.width / 2 - centro);
            if (d < dist) {
              dist = d;
              idx = i;
            }
          });
          idx = Math.max(0, Math.min(lista.length - 1, idx + delta));
          // Se marcan todas las instancias equivalentes: la visible queda
          // resaltada aunque centrar() salte de copia.
          lista.forEach((c, i) => c.classList.toggle('pr-ruta--realce', i % unidad === idx % unidad));
          centrar(lista[idx]);
          intentaReanudar();
        };

        const controles = document.querySelector<HTMLElement>('[data-pr-controles]');
        if (controles) {
          controles.addEventListener('mouseenter', () => {
            sobreControles = true;
            quieto = true;
          });
          controles.addEventListener('mouseleave', () => {
            sobreControles = false;
            intentaReanudar();
          });
          controles.querySelector('[data-pr-anterior]')?.addEventListener('click', () => pasar(-1));
          controles.querySelector('[data-pr-siguiente]')?.addEventListener('click', () => pasar(1));
          const btnSentido = controles.querySelector('[data-pr-sentido]');
          btnSentido?.addEventListener('click', () => {
            sentido = -sentido;
            btnSentido.setAttribute('aria-pressed', sentido === -1 ? 'true' : 'false');
          });
        }
        visor.addEventListener('mouseleave', () => {
          sobreVisor = false;
          cartaActual = null;
          intentaReanudar();
        });
      }
    }
  }
</script>
