{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "manualito",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./public",
    "not_found_handling": "none"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "manualito.dev", "custom_domain": true }]
}
